# ============================================================
# KING DAY - Environment Variables Configuration
# ============================================================
# COPY this file to .env and fill in your actual values.
# NEVER commit .env to Git!
# ============================================================

# ---- DATABASE -----------------------------------------------
# Local Development (SQLite):
DATABASE_URL="file:./prisma/dev.db"

# Railway Production (SQLite persisted volume - Railway sets this automatically):
# DATABASE_URL="file:/app/data/production.db"

# ---- JWT AUTH -----------------------------------------------
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_STRONG_SECRET_KEY_MIN_32_CHARS"

# ---- SERVER -------------------------------------------------
PORT=5000
NODE_ENV=development

# ---- CLIENT CORS ORIGIN ------------------------------------
# In production: set to your Railway public URL e.g. https://king-day.up.railway.app
CLIENT_URL="http://localhost:5173"

# ---- FRONTEND API URL (Vite build-time) --------------------
# Local:
VITE_API_BASE_URL="http://localhost:5000/api"
# Production (same Railway domain, uses relative path):
# VITE_API_BASE_URL="/api"

# ---- WHATSAPP ----------------------------------------------
VITE_WHATSAPP_NUMBER="919495902904"
